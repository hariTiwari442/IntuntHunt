# Frontend env vars
# Copy this file to `.env.local` and fill in your own values.

# Backend API gateway (main-backend)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Public canonical site URL — drives SEO (canonical tags, sitemap.xml, OpenGraph
# image URLs, JSON-LD). Set this to your production domain once it's live, e.g.
# https://leadpulse.io  — no trailing slash. Falls back to https://leadpulse.io
# if unset, so social/sitemap URLs still resolve in dev/preview.
NEXT_PUBLIC_SITE_URL=https://leadpulse.io

# Supabase — required for Realtime lead updates.
# Find these in your Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Paddle Billing (payments). Get from Paddle Dashboard → Developer Tools → Authentication.
# Use sandbox values during testing; switch to live for production.
# The client-side token is browser-safe (NOT a secret).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_ENV=sandbox       # "sandbox" or "production"
