# Frontend env vars
# Copy this file to `.env.local` and fill in your own values.
#
# Every var here is NEXT_PUBLIC_, which means it is compiled into the
# JavaScript bundle at BUILD time and is readable by anyone who opens the
# site. Two consequences worth remembering:
#   - none of these may ever hold a secret;
#   - changing one in Netlify does nothing until the site is rebuilt
#     ("Clear cache and deploy site"), because the old value is baked in.
#
# This file is the checklist when standing up a new environment. Every
# deployed site needs ALL of these set, not just the ones that differ from
# production.

# Backend API gateway (main-backend). MUST end in /api/v1 — lib/api.ts appends
# paths directly to it, so without the suffix every request 404s.
# prod: https://leadpulse-backend-839538790556.asia-south2.run.app/api/v1
# test: https://leadpulse-backend-test-839538790556.asia-south2.run.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Public canonical site URL — drives SEO (canonical tags, sitemap.xml,
# OpenGraph image URLs, JSON-LD). No trailing slash. Falls back to
# https://intenthunt.io if unset, which on a test site means it advertises
# production's URLs as its own — set it explicitly per environment.
NEXT_PUBLIC_SITE_URL=https://intenthunt.io

# Supabase — required for Realtime lead updates.
# Supabase dashboard → Settings → API. The anon key is the public one.
#
# Leaving these unset used to 500 every route importing lib/supabase during
# SSR, because createClient throws on an empty URL. That is now handled: the
# app degrades to no live updates instead of failing. Still set them — without
# them, leads only appear on refresh rather than streaming in during a scan.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Dodo Payments product IDs, read by the pricing page and sent to
# /billing/checkout. These MUST match the backend's DODO_MODE for that
# environment — a test product ID sent to a live-mode backend is rejected by
# Dodo as "no such product", which the UI can only report as
# "Couldn't open checkout".
#   live backend -> live product IDs
#   test backend -> test product IDs
NEXT_PUBLIC_DODO_PRO_MONTHLY_ID=pdt_xxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_DODO_PRO_ANNUAL_ID=pdt_xxxxxxxxxxxxxxxxxxxxx

# ── Non-production only ─────────────────────────────────────────────
# Set on the test/staging site to keep a permanent marker on screen, so
# nobody mistakes it for the live site. Leave UNSET in production.
# NEXT_PUBLIC_ENV_LABEL=Test environment
