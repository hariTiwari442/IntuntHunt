# ---- Required ----
NODE_ENV=development
DATABASE_URL=postgresql://intenthunt:intenthunt@localhost:5432/intenthunt_crawler

# Shared secret — must match INTERNAL_SERVICE_KEY in main-backend's .env.
# Requests without a matching X-Internal-Key header are rejected.
INTERNAL_SERVICE_KEY=

# ---- Optional (defaults shown) ----
PORT=3001
LOG_LEVEL=info
DB_POOL_MIN=2
DB_POOL_MAX=10
WORKER_CONCURRENCY=5
